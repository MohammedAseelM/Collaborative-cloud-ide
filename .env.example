# Production values for docker compose. Copy to .env and do not commit it.
MONGO_ROOT_USERNAME=cloudide
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_URI=mongodb://cloudide:replace-with-a-long-random-password@mongodb:27017/collaborative-cloud-ide?authSource=admin
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=https://mycloudide.com
PUBLIC_HOST=https://mycloudide.com
