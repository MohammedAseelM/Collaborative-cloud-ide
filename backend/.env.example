# ---------- Server Configuration ----------
NODE_ENV=production
PORT=5000

# ---------- Database (MongoDB Atlas) ----------
# Production connection string format for MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/collaborative-cloud-ide?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/collaborative-cloud-ide

# ---------- Client CORS & Links ----------
# Frontend client URL (e.g. Vercel deployment URL or comma-separated URLs)
CLIENT_URL=https://collaborative-cloud-ide.vercel.app

# ---------- Security & JWT Authentication ----------
JWT_SECRET=production_super_secret_jwt_key_collaborative_ide_2026
JWT_EXPIRES_IN=7d

# ---------- Optional Host & Services ----------
# Public host hostname for preview links (optional)
PUBLIC_HOST=http://localhost
# Redis cache connection (optional)
REDIS_URL=redis://127.0.0.1:6379
# Google OAuth Client ID (optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ---------- OpenAI Workspace Assistant ----------
# Create a server-side API key in the OpenAI dashboard. Never put this value
# in frontend/.env, because Vite exposes VITE_* values to the browser.
OPENAI_API_KEY=your_openai_api_key
# Optional: defaults to gpt-5.6
OPENAI_MODEL=gpt-5.6
