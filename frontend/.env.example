# ---------- Frontend Production Environment Variables ----------

# Base URL for the Express API endpoint.
# Development: http://localhost:5000/api (or /api proxied via Vite dev server)
# Production (Vercel -> Render): https://collaborative-cloud-ide-backend.onrender.com/api
VITE_API_URL=https://collaborative-cloud-ide-backend.onrender.com/api
VITE_API_BASE_URL=https://collaborative-cloud-ide-backend.onrender.com/api

# WebSocket Server URL for Socket.IO real-time collaboration.
# Development: http://localhost:5000
# Production: https://your-backend-app.onrender.com
VITE_SOCKET_URL=https://your-backend-app.onrender.com

# Google OAuth Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
